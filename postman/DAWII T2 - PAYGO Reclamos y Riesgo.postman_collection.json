  "item": [
    {
      "name": "00 - Verificar servicios registrados en Eureka",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Eureka responde HTTP 200', function () { pm.response.to.have.status(200); });\nconst apps = pm.response.json().applications.application.map(function (app) { return app.name; });\npm.test('Reclamos y Riesgo están registrados', function () {\n  pm.expect(apps).to.include('MS-RECLAMOS');\n  pm.expect(apps).to.include('MS-RIESGO');\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Accept",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "http://localhost:8761/eureka/apps",
          "protocol": "http",
          "host": [
            "localhost"
          ],
          "port": "8761",
          "path": [
            "eureka",
            "apps"
          ]
        }
      },
      "response": []
    },
    {
      "name": "01 - Registrar reclamo para probar métodos de Reclamos",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Se registra con HTTP 201', function () { pm.response.to.have.status(201); });\nconst data = pm.response.json();\npm.collectionVariables.set('numreclamoDirecto', String(data.numreclamo));\npm.test('Se aplican los valores iniciales', function () {\n  pm.expect(data.analista).to.eql('No asignado');\n  pm.expect(data.estado).to.eql(1);\n  pm.expect(data.observacion).to.eql('por evaluar');\n});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nomcliente\": \"Ana Pérez\",\n  \"ultimos4tarjeta\": \"1234\",\n  \"motivo\": \"Consumo desconocido\"\n}",
          "options": {
            "raw": {
              "language": "text"
            }
          }
        },
        "url": {
          "raw": "http://localhost:8084/api/reclamos",
