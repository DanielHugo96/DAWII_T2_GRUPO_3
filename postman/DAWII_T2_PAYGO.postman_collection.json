{
  "info": {
    "_postman_id": "c89caf2e-0c56-4b43-9280-4697a0060002",
    "name": "DAWII T2 - PAYGO Reclamos y Riesgo",
    "description": "Flujo de registro, consulta y resolución de reclamos usando Eureka y OpenFeign.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "reclamosUrl", "value": "http://localhost:8084" },
    { "key": "riesgoUrl", "value": "http://localhost:8085" },
    { "key": "numreclamoDirecto", "value": "0" },
    { "key": "numreclamoImprocedente", "value": "0" }
  ],
  "item": [
    {
      "name": "00 - Verificar servicios registrados en Eureka",
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": { "raw": "http://localhost:8761/eureka/apps" }
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Eureka responde HTTP 200', function () { pm.response.to.have.status(200); });",
            "const apps = pm.response.json().applications.application.map(function (app) { return app.name; });",
            "pm.test('Reclamos y Riesgo están registrados', function () {",
            "  pm.expect(apps).to.include('MS-RECLAMOS');",
            "  pm.expect(apps).to.include('MS-RIESGO');",
            "});"
          ]
        }
      }]
    },
    {
      "name": "01 - Registrar reclamo para probar métodos de Reclamos",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nomcliente\": \"Ana Pérez\",\n  \"ultimos4tarjeta\": \"1234\",\n  \"motivo\": \"Consumo desconocido\"\n}"
        },
        "url": { "raw": "{{reclamosUrl}}/api/reclamos" }
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Se registra con HTTP 201', function () { pm.response.to.have.status(201); });",
            "const data = pm.response.json();",
            "pm.collectionVariables.set('numreclamoDirecto', String(data.numreclamo));",
            "pm.test('Se aplican los valores iniciales', function () {",
            "  pm.expect(data.analista).to.eql('No asignado');",
            "  pm.expect(data.estado).to.eql(1);",
            "  pm.expect(data.observacion).to.eql('por evaluar');",
            "});"
          ]
        }
      }]
    },
    {
      "name": "02 - Consultar reclamo pendiente por número",
      "request": {
        "method": "GET",
        "url": { "raw": "{{reclamosUrl}}/api/reclamos/{{numreclamoDirecto}}" }
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Consulta HTTP 200', function () { pm.response.to.have.status(200); });",
            "pm.test('El reclamo sigue pendiente', function () { pm.expect(pm.response.json().estado).to.eql(1); });"
          ]
        }
      }]
    },
    {
      "name": "03 - Actualizar reclamo directamente (Pregunta 2)",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"analista\": \"Analista de Riesgos\",\n  \"estado\": 2,\n  \"observacion\": \"Procedente: El consumo no fue reconocido por el titular\"\n}"
        },
        "url": { "raw": "{{reclamosUrl}}/api/reclamos/{{numreclamoDirecto}}" }
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "const data = pm.response.json();",
            "pm.test('Actualización directa HTTP 200', function () { pm.response.to.have.status(200); });",
            "pm.test('Se actualizan analista, estado y observación', function () {",
            "  pm.expect(data.estado).to.eql(2);",
            "  pm.expect(data.analista).to.eql('Analista de Riesgos');",
            "  pm.expect(data.observacion).to.include('Procedente:');",
            "});"
          ]
        }
      }]
    },
    {
      "name": "04 - Confirmar reclamo procedente en Reclamos",
      "request": {
        "method": "GET",
        "url": { "raw": "{{reclamosUrl}}/api/reclamos/{{numreclamoDirecto}}" }
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('El cambio quedó persistido', function () {",
            "  pm.response.to.have.status(200);",
            "  pm.expect(pm.response.json().estado).to.eql(2);",
            "});"
          ]
        }
      }]
    },
    {
      "name": "05 - Registrar reclamo improcedente",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nomcliente\": \"Luis Gómez\",\n  \"ultimos4tarjeta\": \"5678\",\n  \"motivo\": \"Cargo desconocido\"\n}"
        },
        "url": { "raw": "{{reclamosUrl}}/api/reclamos" }
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Se registra el segundo reclamo', function () { pm.response.to.have.status(201); });",
            "pm.collectionVariables.set('numreclamoImprocedente', String(pm.response.json().numreclamo));"
          ]
        }
      }]
    },
    {
      "name": "06 - Resolver como improcedente mediante OpenFeign",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"analista\": \"Analista de Riesgos\",\n  \"estado\": 3,\n  \"observacion\": \"El consumo fue autenticado correctamente\"\n}"
        },
        "url": { "raw": "{{riesgoUrl}}/api/riesgo/reclamos/{{numreclamoImprocedente}}/resolver" }
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Resolución HTTP 200', function () { pm.response.to.have.status(200); });",
            "pm.test('Se registra como improcedente', function () {",
            "  const data = pm.response.json();",
            "  pm.expect(data.reclamo.estado).to.eql(3);",
            "  pm.expect(data.reclamo.observacion).to.include('Improcedente:');",
            "});"
          ]
        }
      }]
    },
    {
      "name": "07 - Verificar error por reclamo inexistente",
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"analista\": \"Analista de Riesgos\",\n  \"estado\": 2,\n  \"observacion\": \"Prueba de reclamo inexistente\"\n}"
        },
        "url": { "raw": "{{riesgoUrl}}/api/riesgo/reclamos/999999999/resolver" }
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('Riesgo informa HTTP 404', function () { pm.response.to.have.status(404); });",
            "pm.test('El error incluye un mensaje', function () { pm.expect(pm.response.json().mensaje).to.be.a('string').and.not.empty; });"
          ]
        }
      }]
    },
    {
      "name": "08 - Verificar validación de tarjeta",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nomcliente\": \"Prueba\",\n  \"ultimos4tarjeta\": \"123\",\n  \"motivo\": \"Datos inválidos\"\n}"
        },
        "url": { "raw": "{{reclamosUrl}}/api/reclamos" }
      },
      "event": [{
        "listen": "test",
        "script": {
          "type": "text/javascript",
          "exec": [
            "pm.test('La validación responde HTTP 400', function () { pm.response.to.have.status(400); });"
          ]
        }
      }]
    }
  ]
}
